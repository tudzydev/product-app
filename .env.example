# ==============================================================================
# ProductHub - Global Environment Variables Template
# Copy this file to .env (and/or backend/.env) and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Settings
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# ------------------------------------------------------------------------------
# 3. Database: Option A - Neon Serverless PostgreSQL (Cloud - Recommended)
# ------------------------------------------------------------------------------
# Pooled connection URL (Recommended for standard queries & pooling)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# Direct / unpooled connection URL (For migrations or non-pgbouncer use)
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require

# Individual Neon connection parameters (Alternative format)
PGHOST=<endpoint>-pooler.<region>.aws.neon.tech
PGHOST_UNPOOLED=<endpoint>.<region>.aws.neon.tech
PGUSER=neondb_owner
PGDATABASE=neondb
PGPASSWORD=your_neon_password

# ------------------------------------------------------------------------------
# 4. Database: Option B - Local / Docker PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=product_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 5. Database Logging & Diagnostics
# ------------------------------------------------------------------------------
DB_LOGGING=false