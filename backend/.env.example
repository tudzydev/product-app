# ==============================================================================
# ProductHub - Backend Environment Variables Template
# Copy this file to backend/.env and populate with your credentials.
# ==============================================================================

PORT=5001
NODE_ENV=development
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Option A: Neon Serverless PostgreSQL (Cloud - Recommended)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require

# Individual Neon parameters (Alternative)
PGHOST=<endpoint>-pooler.<region>.aws.neon.tech
PGUSER=neondb_owner
PGDATABASE=neondb
PGPASSWORD=your_neon_password

# ------------------------------------------------------------------------------
# Option B: Local / Docker PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=product_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# Logging & Debugging
# ------------------------------------------------------------------------------
DB_LOGGING=false
